{
  "kind": "agent",
  "values": {
    "gateway": {
      "mode": "local",
      "bind": "lan",
      "controlUi": {
        "enabled": true
      },
      "auth": {
        "password": {
          "source": "env",
          "provider": "default",
          "id": "OPENCLAW_GATEWAY_PASSWORD"
        }
      }
    },
    "agents": {
      "defaults": {
        "model": {
          "primary": "openai/gpt-4.1"
        },
        "models": {
          "openai/gpt-4.1": {
            "agentRuntime": {
              "id": "openclaw"
            }
          }
        }
      }
    },
    "models": {
      "providers": {
        "openai": {
          "baseUrl": "https://api.openai.com/v1",
          "api": "openai-responses",
          "models": [
            {
              "id": "gpt-4.1",
              "name": "gpt-4.1",
              "contextWindow": 128000,
              "maxTokens": 8192,
              "reasoning": false,
              "cost": {
                "input": 0,
                "output": 0,
                "cacheRead": 0,
                "cacheWrite": 0
              }
            }
          ]
        }
      }
    },
    "browser": {
      "enabled": false
    },
    "tools": {
      "elevated": {
        "enabled": false
      },
      "web": {
        "fetch": {
          "enabled": false
        }
      }
    }
  }
}
